        // GLOBAL APP STATE
        const appState = {
            currentUser: null, // { name, email, role }
            cart: [],
            pickupRequests: [
                { id: 'PU-101', material: 'Cardboard Boxes', quantity: '12 kg', address: '42 Eco Street, Sector 5', status: 'Approved' },
                { id: 'PU-102', material: 'Old Jeans & Denim', quantity: '5 kg', address: 'Green Heights, Apt 2B', status: 'Pending' }
            ],
            marketplaceProducts: [
                { id: 1, title: 'Wood Plant Holder', price: 299, category: 'wood', emoji: '🪴', desc: 'Crafted from wasted wood blocks.' },
                { id: 2, title: 'Recycled Notebook', price: 149, category: 'paper', emoji: '📔', desc: '100% recycled newsprint paper.' },
                { id: 3, title: 'Denim Tote Bag', price: 399, category: 'textile', emoji: '👜', desc: 'Handcrafted from repurposed jeans.' },
                { id: 4, title: 'Cardboard Organizer', price: 199, category: 'cardboard', emoji: '📦', desc: 'Durable multi-tier desk storage.' }
            ]
        };

        // INITIALIZATION
        window.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
            renderMarketplace();
            renderUserPickups();
            updateCartUI();
        });

        // ROUTING / PAGE SWITCHER
        function navigateTo(pageId) {
            document.querySelectorAll('.page-view').forEach(el => el.classList.add('hidden'));
            const targetPage = document.getElementById(`page-${pageId}`);
            if (targetPage) {
                targetPage.classList.remove('hidden');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        function navigateToDashboard() {
            navigateTo('dashboard');
            switchDashboardTab(appState.currentUser?.role === 'Creator' ? 'creator' : 'user');
        }

        // AUTHENTICATION LOGIC
        function handleLoginSubmit(e) {
            e.preventDefault();
            const email = document.getElementById('login-email').value;
            appState.currentUser = {
                name: email.split('@')[0],
                email: email,
                role: 'Buyer'
            };
            updateAuthUI();
            showToast('Login Successful!', 'welcome back');
            navigateToDashboard();
        }

        function handleSignupSubmit(e) {
            e.preventDefault();
            const name = document.getElementById('signup-name').value;
            const email = document.getElementById('signup-email').value;
            const role = document.getElementById('signup-role').value;

            appState.currentUser = { name, email, role };
            updateAuthUI();
            showToast('Account Created!', `Registered as ${role}`);
            navigateToDashboard();
        }

        function logout() {
            appState.currentUser = null;
            updateAuthUI();
            showToast('Logged Out', 'See you again soon!');
            navigateTo('home');
        }

        function updateAuthUI() {
            const authBtns = document.getElementById('nav-auth-buttons');
            const userMenu = document.getElementById('nav-user-menu');
            const dashLink = document.getElementById('nav-dashboard-link');
            const mobileDashLink = document.getElementById('mobile-dashboard-link');

            if (appState.currentUser) {
                authBtns.classList.add('hidden');
                userMenu.classList.remove('hidden');
                dashLink.classList.remove('hidden');
                mobileDashLink.classList.remove('hidden');

                document.getElementById('user-avatar').innerText = appState.currentUser.name.charAt(0).toUpperCase();
                document.getElementById('user-name-display').innerText = appState.currentUser.name;
                document.getElementById('user-email-display').innerText = appState.currentUser.email;
                document.getElementById('user-role-badge').innerText = appState.currentUser.role;
            } else {
                authBtns.classList.remove('hidden');
                userMenu.classList.add('hidden');
                dashLink.classList.add('hidden');
                mobileDashLink.classList.add('hidden');
            }
        }

        function toggleUserDropdown() {
            document.getElementById('user-dropdown').classList.toggle('hidden');
        }

        function toggleMobileMenu() {
            document.getElementById('mobile-menu').classList.toggle('hidden');
        }

        // DASHBOARD SWITCHER
        function switchDashboardTab(tab) {
            document.querySelectorAll('.dash-view').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.dash-tab-btn').forEach(btn => {
                btn.classList.remove('bg-brand-100', 'text-brand-700');
                btn.classList.add('text-gray-600');
            });

            document.getElementById(`dash-view-${tab}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`tab-dash-${tab}`);
            if (activeBtn) {
                activeBtn.classList.add('bg-brand-100', 'text-brand-700');
            }
        }

        // MARKETPLACE RENDER & ACTIONS
        function renderMarketplace(category = 'all') {
            const container = document.getElementById('marketplace-grid');
            container.innerHTML = '';

            const filtered = category === 'all' 
                ? appState.marketplaceProducts 
                : appState.marketplaceProducts.filter(p => p.category === category);

            filtered.forEach(p => {
                const card = document.createElement('div');
                card.className = "bg-white p-5 rounded-3xl border border-brand-100 shadow-sm hover:shadow-md transition flex flex-col justify-between";
                card.innerHTML = `
                    <div>
                        <div class="h-36 bg-brand-50 rounded-2xl flex items-center justify-center text-6xl mb-4 border border-brand-100">
                            ${p.emoji}
                        </div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-brand-600 bg-brand-100 px-2 py-0.5 rounded-md">${p.category}</span>
                        <h3 class="font-bold text-brand-800 text-base mt-1">${p.title}</h3>
                        <p class="text-xs text-gray-500 mt-1">${p.desc}</p>
                    </div>
                    <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between">
                        <span class="text-lg font-black text-brand-800">₹${p.price}</span>
                        <button onclick="addToCart(${p.id})" class="px-3 py-1.5 bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs rounded-xl transition flex items-center gap-1">
                            <i data-lucide="plus" class="w-3.5 h-3.5"></i> Add
                        </button>
                    </div>
                `;
                container.appendChild(card);
            });
            lucide.createIcons();
        }

        function filterMarketplace(cat) {
            document.querySelectorAll('.market-filter-btn').forEach(btn => {
                btn.classList.remove('bg-brand-600', 'text-white');
                btn.classList.add('bg-white', 'text-gray-700');
            });
            event.target.classList.add('bg-brand-600', 'text-white');
            renderMarketplace(cat);
        }

        function addToCart(productId) {
            const product = appState.marketplaceProducts.find(p => p.id === productId);
            if (product) {
                appState.cart.push(product);
                updateCartUI();
                showToast('Added to Cart', product.title);
            }
        }

        function updateCartUI() {
            const badge = document.getElementById('cart-badge');
            if (appState.cart.length > 0) {
                badge.classList.remove('hidden');
                badge.innerText = appState.cart.length;
            } else {
                badge.classList.add('hidden');
            }

            const container = document.getElementById('cart-items-container');
            container.innerHTML = '';
            let total = 0;

            if (appState.cart.length === 0) {
                container.innerHTML = `<p class="text-xs text-gray-400 text-center py-4">Your cart is empty.</p>`;
            } else {
                appState.cart.forEach((item, idx) => {
                    total += item.price;
                    const row = document.createElement('div');
                    row.className = "flex items-center justify-between text-xs py-1 border-b border-gray-50";
                    row.innerHTML = `
                        <div class="flex items-center gap-2">
                            <span>${item.emoji}</span>
                            <span class="font-semibold text-gray-700">${item.title}</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="font-bold">₹${item.price}</span>
                            <button onclick="removeFromCart(${idx})" class="text-red-500 hover:text-red-700"><i data-lucide="trash-2" class="w-3.5 h-3.5"></i></button>
                        </div>
                    `;
                    container.appendChild(row);
                });
            }

            document.getElementById('cart-total-price').innerText = `₹${total}`;
            lucide.createIcons();
        }

        function removeFromCart(index) {
            appState.cart.splice(index, 1);
            updateCartUI();
        }

        function toggleCartModal() {
            document.getElementById('cart-modal').classList.toggle('hidden');
        }

        function checkoutCart() {
            if (appState.cart.length === 0) return;
            showToast('Order Placed!', 'Razorpay / Stripe Payment Processed');
            appState.cart = [];
            updateCartUI();
            toggleCartModal();
        }

        // PICKUP FORM LOGIC
        function handlePickupSubmit(e) {
            e.preventDefault();
            const material = document.getElementById('pickup-material').value;
            const quantity = document.getElementById('pickup-quantity').value + ' kg';
            const address = document.getElementById('pickup-address').value;

            const newPickup = {
                id: `PU-${Math.floor(100 + Math.random() * 900)}`,
                material,
                quantity,
                address,
                status: 'Pending'
            };

            appState.pickupRequests.unshift(newPickup);
            renderUserPickups();
            showToast('Pickup Requested!', 'A local recycler will accept your job.');
            navigateToDashboard();
        }

        function renderUserPickups() {
            const tbody = document.getElementById('user-pickups-tbody');
            tbody.innerHTML = '';
            appState.pickupRequests.forEach(p => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="py-3 font-mono text-[11px] font-bold text-gray-500">${p.id}</td>
                    <td class="py-3 font-semibold text-gray-800">${p.material}</td>
                    <td class="py-3">${p.quantity}</td>
                    <td class="py-3 text-gray-500 truncate max-w-xs">${p.address}</td>
                    <td class="py-3"><span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${p.status === 'Approved' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700'}">${p.status}</span></td>
                `;
                tbody.appendChild(tr);
            });
            document.getElementById('user-dash-pickup-count').innerText = appState.pickupRequests.length;
        }

        function previewPickupImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('pickup-photo-preview-container').innerHTML = `
                        <img src="${e.target.result}" class="h-24 mx-auto rounded-xl border border-brand-200">
                    `;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        // AI SCANNER SIMULATION
        let selectedAISample = 'cardboard';

        function triggerAISample(type) {
            selectedAISample = type;
            const preview = document.getElementById('ai-img-preview');
            const placeholder = document.getElementById('ai-upload-placeholder');
            
            placeholder.classList.add('hidden');
            preview.classList.remove('hidden');

            if (type === 'wood') preview.src = 'https://placehold.co/400x300/e4f4df/1f6335?text=Wasted+Wood+Blocks';
            else if (type === 'cardboard') preview.src = 'https://placehold.co/400x300/e4f4df/1f6335?text=Cardboard+Boxes';
            else if (type === 'denim') preview.src = 'https://placehold.co/400x300/e4f4df/1f6335?text=Used+Denim+Scraps';
        }

        function runAIScan(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('ai-upload-placeholder').classList.add('hidden');
                    const img = document.getElementById('ai-img-preview');
                    img.src = e.target.result;
                    img.classList.remove('hidden');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function analyzeSelectedAI() {
            document.getElementById('ai-empty-state').classList.add('hidden');
            document.getElementById('ai-results').classList.add('hidden');
            document.getElementById('ai-loader').classList.remove('hidden');

            setTimeout(() => {
                document.getElementById('ai-loader').classList.add('hidden');
                document.getElementById('ai-results').classList.remove('hidden');
                document.getElementById('ai-action-btn').classList.remove('hidden');

                if (selectedAISample === 'wood') {
                    document.getElementById('ai-res-material').innerText = 'Scrap Wood & Timber';
                    document.getElementById('ai-res-confidence').innerText = '96.2%';
                    document.getElementById('ai-res-ideas').innerHTML = `
                        <li class="flex items-center gap-2"><i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-brand-600"></i> Plant Pots & Furniture Framework</li>
                        <li class="flex items-center gap-2"><i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-brand-600"></i> Decorative Wall Art Pieces</li>
                    `;
                } else if (selectedAISample === 'denim') {
                    document.getElementById('ai-res-material').innerText = 'Cotton Denim Fabrics';
                    document.getElementById('ai-res-confidence').innerText = '91.5%';
                    document.getElementById('ai-res-ideas').innerHTML = `
                        <li class="flex items-center gap-2"><i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-brand-600"></i> Upcycled Denim Tote Bags</li>
                        <li class="flex items-center gap-2"><i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-brand-600"></i> Fabric Insulation & Quilts</li>
                    `;
                } else {
                    document.getElementById('ai-res-material').innerText = 'Cardboard Packaging';
                    document.getElementById('ai-res-confidence').innerText = '94.8%';
                    document.getElementById('ai-res-ideas').innerHTML = `
                        <li class="flex items-center gap-2"><i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-brand-600"></i> Desk Organizers & Storage Boxes</li>
                        <li class="flex items-center gap-2"><i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-brand-600"></i> Recycled Pulp Crafts</li>
                    `;
                }
                lucide.createIcons();
            }, 1200);
        }

        function requestPickupWithAIMaterial() {
            navigateTo('pickup');
            showToast('AI Transfer Complete', 'Material auto-selected in pickup form.');
        }

        // CREATOR ADD PRODUCT
        function handleCreatorAddProduct(e) {
            e.preventDefault();
            const title = document.getElementById('prod-title').value;
            const price = parseInt(document.getElementById('prod-price').value);
            const category = document.getElementById('prod-category').value;
            const emoji = document.getElementById('prod-emoji').value || '🪴';

            const newProduct = {
                id: Date.now(),
                title,
                price,
                category,
                emoji,
                desc: 'Creator upcycled product.'
            };

            appState.marketplaceProducts.unshift(newProduct);
            renderMarketplace();
            showToast('Product Published!', `${title} added to Marketplace.`);
            document.getElementById('creator-add-product-form').reset();
            document.getElementById('creator-product-count').innerText = appState.marketplaceProducts.length;
        }

        // TOAST NOTIFIER
        function showToast(title, subtitle) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = "pointer-events-auto bg-brand-800 text-white px-4 py-3 rounded-2xl shadow-xl flex items-center gap-3 animate-fade-in border border-brand-600";
            toast.innerHTML = `
                <div class="p-1 bg-brand-600 rounded-lg"><i data-lucide="check-circle" class="w-4 h-4"></i></div>
                <div>
                    <h5 class="text-xs font-bold leading-none">${title}</h5>
                    <p class="text-[10px] text-brand-200 mt-0.5">${subtitle}</p>
                </div>
            `;
            container.appendChild(toast);
            lucide.createIcons();

            setTimeout(() => {
                toast.remove();
            }, 3000);
        }
    </script>
</body>
</html>
