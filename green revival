<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Green Revival - Turning Waste into Worth</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f6faf5',
                            100: '#e4f4df',
                            200: '#c5e8bb',
                            500: '#71a94e',
                            600: '#237a3b',
                            700: '#1f6335',
                            800: '#173a21',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
        body { font-family: 'Inter', sans-serif; background-color: #f6faf5; color: #203127; }
        .glass-panel { background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(12px); }
        .animate-fade-in { animation: fadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #f1f5f1; }
        ::-webkit-scrollbar-thumb { background: #c5e8bb; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #71a94e; }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-brand-100 selection:text-brand-800">

    <!-- NAVIGATION BAR -->
    <header class="sticky top-0 z-40 w-full glass-panel border-b border-brand-100 shadow-sm transition-all duration-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <!-- Logo -->
            <button onclick="navigateTo('home')" class="flex items-center space-x-2.5 text-brand-700 font-extrabold text-xl tracking-tight focus:outline-none">
                <span class="p-2 bg-brand-100 rounded-xl text-brand-600 flex items-center justify-center">
                    <i data-lucide="sprout" class="w-6 h-6"></i>
                </span>
                <span class="flex flex-col text-left">
                    <span class="leading-none text-brand-800">Green Revival</span>
                    <span class="text-[10px] text-brand-500 font-medium tracking-wider uppercase mt-0.5">Waste to Worth</span>
                </span>
            </button>

            <!-- Navigation Links -->
            <nav class="hidden md:flex items-center space-x-1 lg:space-x-2 text-sm font-medium">
                <button onclick="navigateTo('home')" class="nav-btn px-3 py-2 rounded-lg text-gray-700 hover:text-brand-700 hover:bg-brand-50 transition">Home</button>
                <button onclick="navigateTo('marketplace')" class="nav-btn px-3 py-2 rounded-lg text-gray-700 hover:text-brand-700 hover:bg-brand-50 transition">Marketplace</button>
                <button onclick="navigateTo('pickup')" class="nav-btn px-3 py-2 rounded-lg text-gray-700 hover:text-brand-700 hover:bg-brand-50 transition">Request Pickup</button>
                <button onclick="navigateTo('ai-identify')" class="nav-btn px-3 py-2 rounded-lg text-gray-700 hover:text-brand-700 hover:bg-brand-50 transition flex items-center gap-1.5">
                    <i data-lucide="sparkles" class="w-4 h-4 text-brand-500"></i> AI Scanner
                </button>
                
                <div class="h-4 w-px bg-gray-200 mx-2"></div>

                <div id="nav-dashboard-link" class="hidden">
                    <button onclick="navigateToDashboard()" class="px-3 py-2 rounded-lg text-brand-700 bg-brand-100/70 font-semibold hover:bg-brand-200 transition flex items-center gap-1.5">
                        <i data-lucide="layout-dashboard" class="w-4 h-4"></i> Dashboard
                    </button>
                </div>
            </nav>

            <!-- Action Buttons / Profile -->
            <div class="flex items-center space-x-3">
                <!-- Cart Button -->
                <button onclick="toggleCartModal()" class="relative p-2 rounded-xl text-gray-700 hover:bg-brand-50 hover:text-brand-700 transition focus:outline-none">
                    <i data-lucide="shopping-bag" class="w-5 h-5"></i>
                    <span id="cart-badge" class="hidden absolute -top-1 -right-1 bg-brand-600 text-white text-[10px] font-bold w-5 h-5 rounded-full flex items-center justify-center border-2 border-white">0</span>
                </button>

                <div id="nav-auth-buttons" class="flex items-center space-x-2">
                    <button onclick="navigateTo('login')" class="text-sm font-semibold px-4 py-2 rounded-lg text-brand-700 hover:bg-brand-50 transition">Log In</button>
                    <button onclick="navigateTo('signup')" class="text-sm font-semibold px-4 py-2 rounded-lg bg-brand-600 hover:bg-brand-700 text-white shadow-md shadow-brand-600/20 transition">Sign Up</button>
                </div>

                <div id="nav-user-menu" class="hidden flex items-center gap-3">
                    <div class="relative inline-block text-left">
                        <button id="user-menu-btn" onclick="toggleUserDropdown()" class="flex items-center gap-2 p-1.5 rounded-xl border border-gray-200 hover:border-brand-300 bg-white transition">
                            <div id="user-avatar" class="w-8 h-8 rounded-lg bg-brand-600 text-white flex items-center justify-center font-bold text-xs">U</div>
                            <span id="user-name-display" class="text-xs font-semibold text-gray-700 hidden sm:inline-block pr-1">User</span>
                            <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-gray-400"></i>
                        </button>
                        <div id="user-dropdown" class="hidden absolute right-0 mt-2 w-48 rounded-xl bg-white shadow-xl border border-gray-100 py-1 z-50 animate-fade-in">
                            <div class="px-4 py-2 border-b border-gray-100">
                                <p id="user-role-badge" class="text-[10px] font-bold text-brand-600 uppercase tracking-wider">Role</p>
                                <p id="user-email-display" class="text-xs text-gray-500 truncate">user@greenrevival.org</p>
                            </div>
                            <button onclick="navigateToDashboard(); toggleUserDropdown();" class="w-full text-left px-4 py-2 text-xs text-gray-700 hover:bg-brand-50 flex items-center gap-2">
                                <i data-lucide="layout-dashboard" class="w-3.5 h-3.5"></i> Dashboard
                            </button>
                            <button onclick="logout()" class="w-full text-left px-4 py-2 text-xs text-red-600 hover:bg-red-50 flex items-center gap-2">
                                <i data-lucide="log-out" class="w-3.5 h-3.5"></i> Log Out
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Mobile Menu Toggle -->
                <button onclick="toggleMobileMenu()" class="md:hidden p-2 rounded-lg text-gray-600 hover:bg-brand-50">
                    <i data-lucide="menu" class="w-6 h-6"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Navigation Menu -->
        <div id="mobile-menu" class="hidden md:hidden border-t border-brand-100 bg-white px-4 pt-2 pb-4 space-y-2">
            <button onclick="navigateTo('home'); toggleMobileMenu()" class="w-full text-left px-3 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-brand-50">Home</button>
            <button onclick="navigateTo('marketplace'); toggleMobileMenu()" class="w-full text-left px-3 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-brand-50">Marketplace</button>
            <button onclick="navigateTo('pickup'); toggleMobileMenu()" class="w-full text-left px-3 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-brand-50">Request Pickup</button>
            <button onclick="navigateTo('ai-identify'); toggleMobileMenu()" class="w-full text-left px-3 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-brand-50 flex items-center gap-2">
                <i data-lucide="sparkles" class="w-4 h-4 text-brand-500"></i> AI Material Identification
            </button>
            <div id="mobile-dashboard-link" class="hidden pt-2 border-t border-gray-100">
                <button onclick="navigateToDashboard(); toggleMobileMenu()" class="w-full text-left px-3 py-2 rounded-lg text-sm font-semibold text-brand-700 bg-brand-50 flex items-center gap-2">
                    <i data-lucide="layout-dashboard" class="w-4 h-4"></i> My Dashboard
                </button>
            </div>
        </div>
    </header>

    <!-- TOAST NOTIFICATION CONTAINER -->
    <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- MAIN CONTENT CONTAINER -->
    <main class="flex-grow">
        
        <!-- ================= PAGE 1: HOME ================= -->
        <section id="page-home" class="page-view animate-fade-in">
            <!-- Hero Banner -->
            <div class="relative bg-gradient-to-br from-brand-100 via-brand-50 to-white overflow-hidden py-16 sm:py-24 border-b border-brand-100">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                        <div class="lg:col-span-7 space-y-6">
                            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-200/60 border border-brand-300 text-brand-800 text-xs font-semibold tracking-wide uppercase">
                                <i data-lucide="recycle" class="w-4 h-4 text-brand-600"></i> Sustainable Waste Ecosystem
                            </div>
                            <h1 class="text-4xl sm:text-6xl font-black text-brand-800 tracking-tight leading-[1.15]">
                                Turning Waste into <span class="text-brand-600 underline decoration-brand-300">Worth.</span>
                            </h1>
                            <p class="text-lg text-gray-600 max-w-2xl font-normal leading-relaxed">
                                Give discarded materials a second life. Green Revival seamlessly bridges the gap between waste generators, local recyclers, and creative upcycling artisans.
                            </p>
                            <div class="pt-2 flex flex-wrap gap-4">
                                <button onclick="navigateTo('pickup')" class="px-6 py-3.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm shadow-lg shadow-brand-600/25 transition transform active:scale-95 flex items-center gap-2">
                                    <i data-lucide="truck" class="w-4 h-4"></i> Request Waste Pickup
                                </button>
                                <button onclick="navigateTo('marketplace')" class="px-6 py-3.5 rounded-xl bg-white hover:bg-brand-50 text-brand-700 border border-brand-300 font-bold text-sm shadow-sm transition transform active:scale-95 flex items-center gap-2">
                                    <i data-lucide="shopping-bag" class="w-4 h-4"></i> Explore Marketplace
                                </button>
                            </div>
                            <!-- Live Impact Counter Strip -->
                            <div class="pt-6 grid grid-cols-3 gap-4 border-t border-brand-200/50 max-w-md">
                                <div>
                                    <div class="text-2xl font-extrabold text-brand-700" id="stat-waste-reused">1,250 kg</div>
                                    <div class="text-xs text-gray-500 font-medium">Waste Diverted</div>
                                </div>
                                <div>
                                    <div class="text-2xl font-extrabold text-brand-700" id="stat-products-created">250+</div>
                                    <div class="text-xs text-gray-500 font-medium">Upcycled Items</div>
                                </div>
                                <div>
                                    <div class="text-2xl font-extrabold text-brand-700" id="stat-active-users">120</div>
                                    <div class="text-xs text-gray-500 font-medium">Active Eco-Users</div>
                                </div>
                            </div>
                        </div>
                        <!-- Hero Graphics / Visual Card -->
                        <div class="lg:col-span-5 relative">
                            <div class="relative mx-auto max-w-md rounded-3xl bg-white p-6 shadow-2xl border border-brand-100 space-y-6">
                                <div class="flex items-center justify-between pb-4 border-b border-gray-100">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-xl bg-brand-100 text-brand-600 flex items-center justify-center font-bold">
                                            <i data-lucide="cpu" class="w-5 h-5"></i>
                                        </div>
                                        <div>
                                            <h4 class="text-sm font-bold text-gray-800">Smart AI Material Identifier</h4>
                                            <p class="text-xs text-gray-500">AWS Bedrock Powered</p>
                                        </div>
                                    </div>
                                    <span class="px-2.5 py-1 bg-green-100 text-green-700 text-[10px] font-bold rounded-full">ACTIVE</span>
                                </div>
                                <div class="bg-brand-50 rounded-2xl p-4 text-center border border-dashed border-brand-300">
                                    <div class="text-4xl mb-2">📦 📰 👖 🪵</div>
                                    <p class="text-xs font-medium text-brand-800">Cardboard, Wood, Denim & Textiles</p>
                                    <span class="text-[11px] text-gray-500">Detect reusable resources instantly with image recognition.</span>
                                </div>
                                <button onclick="navigateTo('ai-identify')" class="w-full py-2.5 bg-brand-100 hover:bg-brand-200 text-brand-800 font-semibold text-xs rounded-xl transition flex items-center justify-center gap-2">
                                    Try AI Material Scanner <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Workflow Section -->
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
                <div class="text-center max-w-2xl mx-auto mb-12">
                    <h2 class="text-xs font-bold uppercase tracking-wider text-brand-600">Simple Process</h2>
                    <h3 class="text-3xl font-bold text-brand-800 mt-1">How Green Revival Works</h3>
                    <p class="text-gray-600 text-sm mt-2">Connecting waste producers with upcycling creators step by step.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-brand-100 hover:shadow-md transition">
                        <div class="w-12 h-12 rounded-xl bg-brand-100 text-brand-700 flex items-center justify-center font-bold text-lg mb-4">01</div>
                        <h4 class="font-bold text-brand-800 text-lg">Collect</h4>
                        <p class="text-gray-600 text-sm mt-2">Submit unwanted wooden blocks, paper, cardboard, or old clothes for pickup.</p>
                    </div>
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-brand-100 hover:shadow-md transition">
                        <div class="w-12 h-12 rounded-xl bg-brand-100 text-brand-700 flex items-center justify-center font-bold text-lg mb-4">02</div>
                        <h4 class="font-bold text-brand-800 text-lg">Identify</h4>
                        <p class="text-gray-600 text-sm mt-2">AI scans material type, quality, and potential upcycling capabilities.</p>
                    </div>
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-brand-100 hover:shadow-md transition">
                        <div class="w-12 h-12 rounded-xl bg-brand-100 text-brand-700 flex items-center justify-center font-bold text-lg mb-4">03</div>
                        <h4 class="font-bold text-brand-800 text-lg">Transform</h4>
                        <p class="text-gray-600 text-sm mt-2">Verified creators and recyclers turn raw materials into functional goods.</p>
                    </div>
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-brand-100 hover:shadow-md transition">
                        <div class="w-12 h-12 rounded-xl bg-brand-100 text-brand-700 flex items-center justify-center font-bold text-lg mb-4">04</div>
                        <h4 class="font-bold text-brand-800 text-lg">Reuse</h4>
                        <p class="text-gray-600 text-sm mt-2">Purchase unique upcycled products and support local sustainable artisans.</p>
                    </div>
                </div>
            </div>

            <!-- Material Focus Section -->
            <div class="bg-brand-100/50 py-16 border-y border-brand-200">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <h2 class="text-2xl font-bold text-brand-800 text-center mb-8">Materials We Collect & Upcycle</h2>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <div class="bg-white p-5 rounded-2xl text-center border border-brand-200 shadow-sm hover:scale-[1.02] transition">
                            <div class="text-4xl mb-2">🪵</div>
                            <h4 class="font-bold text-brand-800 text-sm">Wasted Wood</h4>
                            <p class="text-xs text-gray-500 mt-1">Pallets, scrap blocks, old furniture pieces</p>
                        </div>
                        <div class="bg-white p-5 rounded-2xl text-center border border-brand-200 shadow-sm hover:scale-[1.02] transition">
                            <div class="text-4xl mb-2">📦</div>
                            <h4 class="font-bold text-brand-800 text-sm">Cardboard</h4>
                            <p class="text-xs text-gray-500 mt-1">Shipping boxes, packaging materials</p>
                        </div>
                        <div class="bg-white p-5 rounded-2xl text-center border border-brand-200 shadow-sm hover:scale-[1.02] transition">
                            <div class="text-4xl mb-2">📰</div>
                            <h4 class="font-bold text-brand-800 text-sm">Paper Waste</h4>
                            <p class="text-xs text-gray-500 mt-1">Newspapers, office paper, notebooks</p>
                        </div>
                        <div class="bg-white p-5 rounded-2xl text-center border border-brand-200 shadow-sm hover:scale-[1.02] transition">
                            <div class="text-4xl mb-2">👖</div>
                            <h4 class="font-bold text-brand-800 text-sm">Denim & Clothes</h4>
                            <p class="text-xs text-gray-500 mt-1">Used apparel, fabric scraps, denim jeans</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= PAGE 2: MARKETPLACE ================= -->
        <section id="page-marketplace" class="page-view hidden animate-fade-in py-8 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                <div>
                    <h1 class="text-3xl font-extrabold text-brand-800">Upcycled Marketplace</h1>
                    <p class="text-sm text-gray-600 mt-1">Shop unique, high-quality products crafted from recycled materials.</p>
                </div>
                <!-- Filters -->
                <div class="flex items-center gap-2 overflow-x-auto pb-2 md:pb-0">
                    <button onclick="filterMarketplace('all')" class="market-filter-btn active-filter px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-brand-600 text-white shadow-sm">All Items</button>
                    <button onclick="filterMarketplace('wood')" class="market-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-gray-700 hover:bg-brand-50 border border-gray-200">Wood</button>
                    <button onclick="filterMarketplace('paper')" class="market-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-gray-700 hover:bg-brand-50 border border-gray-200">Paper</button>
                    <button onclick="filterMarketplace('textile')" class="market-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-gray-700 hover:bg-brand-50 border border-gray-200">Denim & Fabric</button>
                    <button onclick="filterMarketplace('cardboard')" class="market-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-gray-700 hover:bg-brand-50 border border-gray-200">Cardboard</button>
                </div>
            </div>

            <!-- Product Grid -->
            <div id="marketplace-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Dynamic Products Rendered Here -->
            </div>
        </section>

        <!-- ================= PAGE 3: WASTE PICKUP REQUEST ================= -->
        <section id="page-pickup" class="page-view hidden animate-fade-in py-8 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="bg-white rounded-3xl p-6 sm:p-10 shadow-xl border border-brand-100">
                <div class="flex items-center gap-3 mb-6">
                    <div class="p-3 bg-brand-100 rounded-2xl text-brand-600">
                        <i data-lucide="truck" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl font-bold text-brand-800">Request Waste Pickup</h1>
                        <p class="text-xs text-gray-500">Schedule doorstep collection for your reusable materials.</p>
                    </div>
                </div>

                <form id="pickup-form" onsubmit="handlePickupSubmit(event)" class="space-y-5">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Material Type</label>
                        <select id="pickup-material" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none text-sm bg-gray-50/50">
                            <option value="Wasted Wooden Blocks">Wasted Wooden Blocks & Pieces</option>
                            <option value="Cardboard Boxes">Cardboard Boxes & Scraps</option>
                            <option value="Old Newspapers & Paper">Old Newspapers & Used Paper</option>
                            <option value="Discarded Cloth Materials">Discarded Fabrics / Clothes</option>
                            <option value="Old Jeans & Denim">Old Jeans & Denim Fabrics</option>
                        </select>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Estimated Quantity (kg)</label>
                            <input type="number" id="pickup-quantity" min="1" max="500" value="5" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none text-sm bg-gray-50/50" placeholder="e.g. 10">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Preferred Date</label>
                            <input type="date" id="pickup-date" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none text-sm bg-gray-50/50">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Pickup Address</label>
                        <textarea id="pickup-address" rows="3" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none text-sm bg-gray-50/50" placeholder="Street name, landmark, city, postal code..."></textarea>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Upload Photo (Optional)</label>
                        <div class="border-2 border-dashed border-gray-300 rounded-2xl p-4 text-center hover:bg-brand-50/50 transition cursor-pointer relative" onclick="document.getElementById('pickup-photo-input').click()">
                            <input type="file" id="pickup-photo-input" accept="image/*" class="hidden" onchange="previewPickupImage(this)">
                            <div id="pickup-photo-preview-container">
                                <i data-lucide="upload-cloud" class="w-8 h-8 text-brand-500 mx-auto mb-2"></i>
                                <p class="text-xs font-semibold text-gray-700">Click to attach photo</p>
                                <p class="text-[10px] text-gray-400 mt-0.5">PNG, JPG or WEBP up to 5MB</p>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="w-full py-3.5 bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm rounded-xl shadow-lg shadow-brand-600/20 transition">
                        Submit Pickup Request
                    </button>
                </form>
            </div>
        </section>

        <!-- ================= PAGE 4: AI MATERIAL IDENTIFIER ================= -->
        <section id="page-ai-identify" class="page-view hidden animate-fade-in py-8 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-xl mx-auto mb-8">
                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-100 text-brand-700 text-xs font-bold mb-2">
                    <i data-lucide="sparkles" class="w-3.5 h-3.5"></i> Amazon Rekognition & Bedrock AI
                </div>
                <h1 class="text-3xl font-extrabold text-brand-800">AI Material Identification</h1>
